# Recovery partition SDK config - Bluedroid
# Using Bluedroid stack for Android app compatibility
# Enable Classic BT + A2DP to make modified ESP-IDF headers happy
# But we only USE BLE GATT in recovery code

# Enable Bluetooth with Bluedroid stack
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y

# Keep Classic BT + A2DP enabled (required for this modified ESP-IDF)
CONFIG_BTDM_CTRL_MODE_BTDM=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y

# Disable extra decoders we don't need (shrink size)
CONFIG_BT_A2DP_APTX_DECODER=n
CONFIG_BT_A2DP_LDAC_DECODER=n
CONFIG_BT_A2DP_AAC_DECODER=n
CONFIG_BT_A2DP_OPUS_DECODER=n
CONFIG_BT_A2DP_LC3PLUS_DECODER=n

# Disable unused Classic BT profiles
CONFIG_BT_SPP_ENABLED=n
CONFIG_BT_L2CAP_ENABLED=n
CONFIG_BT_HFP_ENABLE=n
CONFIG_BT_HID_ENABLED=n
CONFIG_BT_AVRCP_ENABLED=n

# BLE enabled with GATT server
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_GATTS_ENABLE=y
CONFIG_BT_GATTC_ENABLE=n
CONFIG_BT_BLE_SMP_ENABLE=n

# BLE connection settings
CONFIG_BT_ACL_CONNECTIONS=2
CONFIG_BT_BLE_DYNAMIC_ENV_MEMORY=n

# Disable WiFi (not needed for recovery)
CONFIG_ESP_WIFI_ENABLED=n

# Flash size
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../partitions.csv"

# Optimization for size
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Disable unused features
CONFIG_SPIRAM=n
CONFIG_ESP32_SPIRAM_SUPPORT=n

# Console for debugging
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# Disable unused HTTP/network features
CONFIG_ESP_HTTPS_OTA_ENABLED=n
CONFIG_HTTPD_WS_SUPPORT=n

# Reduce log level for smaller binary
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
